{
  "name": "pomidorqa-course-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Официальный репозиторий марафона «Автоматизация на Playwright + TypeScript» — эталонные тесты PomidorQA (aiqa.su/pomidorqa) для чтения на уроках и площадка для домашних заданий студентов",
  "scripts": {
    "test": "playwright test --project=unit --project=api --project=e2e",
    "test:unit": "playwright test --project=unit",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:safari": "playwright test --project=e2e-safari",
    "test:e2e:edge": "playwright test --project=e2e-edge",
    "typecheck": "tsc --noEmit",
    "lint": "eslint tests",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1"
  }
}
